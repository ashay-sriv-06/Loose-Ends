{
  "name": "loose-ends",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server\" \"vite\"",
    "server": "tsx src/server/main.ts",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture:reset": "tsx scripts/fixture.ts reset",
    "fixture:build": "tsx scripts/fixture.ts build",
    "skill:package": "tsx scripts/package-skill.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
